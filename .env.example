# Copy this file to .env and fill in local credentials and tool paths.
GOOGLE_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini
SCOUT_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
RED_TEAM_MODEL=gpt-4o
BLUE_TEAM_MODEL=deepseek-coder:7b
OLLAMA_HOST=http://127.0.0.1:11434
# Hard process timeout includes compilation and symbolic execution.
COMMAND_TIMEOUT_SECONDS=120
SOLC_BINARY=
MYTHRIL_BINARY=
MYTHRIL_EXECUTION_TIMEOUT_SECONDS=60
MYTHRIL_TRANSACTION_COUNT=2
MYTHRIL_MAX_SOURCES=10
MAX_RETRIES=5
OUTPUT_DIR=reports
